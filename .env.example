# ============================================
# SUPABASE (REQUIRED - the real backend)
# Copy this file to .env.local and fill in the values.
# Get them from your Supabase project: Settings -> API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - KEEP SECRET, server-only.
# Required for the Stripe webhook to settle payments.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# STRIPE (optional - real card/ACH rent collection)
# Without these, tenant payments run in manual-record mode.
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
